// Scoped AOT removes repeated scalar work while preserving calls and effects.
fn calculate(x: Int) -> Int {
    #scope[opt] {
        let square = x * x;
        let repeated = x * x;
        return square + repeated;
    }
}

fn main() {
    let mut index = arg_count();
    while index < 5 {
        println(calculate(index));
        index = index + 1;
    }
}
