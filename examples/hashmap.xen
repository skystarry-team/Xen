use std.hashmap as hashmap;

#![explc]
fn main() {
    let mut prices = hashmap.new<Int>();
    prices.insert("tea", 3);
    prices.insert("coffee", 4);
    let key = "tea";
    println(match prices.get_cloned(&key) {
        Option.Some(price) => price,
        Option.None => 0,
    });
    println(prices.len());
}
