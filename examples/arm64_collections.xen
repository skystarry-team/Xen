use std.string;
use std.iter;
use std.hashmap;

#global[explc]
fn main() {
    let mut words = std.string.split_ascii_whitespace("hello ARM64 collections");
    let saved = words;
    words.set(0, "new");
    let view = saved.as_slice();
    println(view[0]);

    let mut map = std.hashmap.new<Box<String>>();
    for word in words.into_iter() { map.insert(word, box("stored value")); }
    println(map.len());
    let key = "ARM64";
    println(match map.remove(&key) {
        Option.Some(value) => value.into_inner(),
        Option.None => "missing",
    });
}
