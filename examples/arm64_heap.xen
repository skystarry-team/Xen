// Build with --target=aarch64-linux --jit=off, then run on Linux ARM64 or QEMU.
enum List { Empty, Link(Item) }
struct Item { text: String, next: Box<List> }

fn make_list(count: I64) -> Box<List> {
    let mut list = List.Empty;
    let mut index = 0;
    while index < count {
        list = List.Link(Item {
            text: "item " + int_to_str(index),
            next: box(list)
        });
        index = index + 1;
    }
    return box(list);
}

fn main() {
    let mut current = make_list(3).into_inner();
    while true {
        current = match current {
            List.Empty => { break; },
            List.Link(item) => {
                println(item.text);
                item.next.into_inner()
            }
        };
    }
    // Unconsumed recursive values are also cleaned up at the scope exit.
    let remaining = make_list(1000);
}
