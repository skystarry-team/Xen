(library
 (name xen_compiler)
 (wrapped false)
 (modules backend host_config test_runner)
 (libraries unix xen_common xen_linux_x86_64 xen_linux_arm64 xen_windows_x86_64 xen_darwin_arm64))

(executable
 (name main)
 (modules main build_version)
 (libraries unix xen_compiler))

(executable
 (name version_gen)
 (modules version_gen))

(rule
 (targets build_version.ml)
 (deps ../VERSION)
 (action
  (with-stdout-to build_version.ml
   (run %{exe:version_gen.exe} %{dep:../VERSION} %{env:XEN_BUILD_VERSION=}))))

(rule
 (alias release)
 (targets xen)
 (enabled_if (<> %{os_type} Win32))
 (deps main.exe)
 (mode (promote (into dist) (until-clean)))
 (action (copy main.exe xen)))

(rule
 (alias release)
 (targets xen.exe)
 (enabled_if (= %{os_type} Win32))
 (deps main.exe)
 (mode (promote (into dist) (until-clean)))
 (action (copy main.exe xen.exe)))

(rule
 (targets host_config.ml)
 (action
  (with-stdout-to host_config.ml
   (echo "(* Generated from the OCaml compiler configuration, never uname/PATH. *)\nlet architecture = \"%{ocaml-config:architecture}\"\nlet system = \"%{ocaml-config:system}\"\n"))))
