(library
 (name xen_compiler)
 (wrapped false)
 (modules backend test_runner)
 (libraries unix xen_common xen_x86_64 xen_arm64))

(executable
 (name main)
 (modules main build_version)
 (libraries unix xen_compiler))

(executable
 (name version_gen)
 (modules version_gen))

(rule
 (targets build_version.ml)
 (deps ../VERSION)
 (action
  (with-stdout-to build_version.ml
   (run %{exe:version_gen.exe} %{dep:../VERSION} %{env:XEN_BUILD_VERSION=}))))

(rule
 (alias release)
 (targets xen)
 (deps main.exe)
 (mode (promote (into dist) (until-clean)))
 (action (copy main.exe xen)))
