module std.env;
use std.io;
use std.platform;

fn args() -> Vec<String> {
    let count = arg_count();
    let mut values: Vec<String> = [];
    for index in 0..count {
        values.push(arg(index));
    }
    return values;
}

fn cwd() -> Result<String, std.io.IoError> {
    return match std.platform.cwd() {
        Result.Err(code) => Result<String, std.io.IoError>.Err(std.io.IoError.Cwd(code)),
        Result.Ok(path) => Result<String, std.io.IoError>.Ok(path),
    };
}

test fn current_directory() {
    assert(match cwd() { Result.Ok(path) => len(path) > 0, _ => false });
}
