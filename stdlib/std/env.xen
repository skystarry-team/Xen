module std.env;
use std.io;

fn args() -> Vec<String> {
    let count = arg_count();
    let mut values: Vec<String> = [];
    for index in 0..count {
        values.push(arg(index));
    }
    return values;
}

// The Linux kernel getcwd limit is 4096 bytes, including the terminator.
fn cwd() -> Result<String, std.io.IoError> {
    #scope[bb] {
        let buffer = raw_alloc<U8>(4096);
        let count = syscall2(79, ptr_addr(buffer), 4096);
        if count < 0 {
            raw_free(buffer);
            return Result<String, std.io.IoError>.Err(std.io.IoError.Cwd(-count));
        }
        if count < 1 || count > 4096 || raw_load(buffer, 0) != u8(47) {
            raw_free(buffer);
            return Result<String, std.io.IoError>.Err(std.io.IoError.Cwd(2));
        }
        let mut bytes: Vec<U8> = [];
        for index in 0..(count - 1) { bytes.push(raw_load(buffer, index)); }
        raw_free(buffer);
        return Result<String, std.io.IoError>.Ok(bytes.into_string());
    }
}

test fn current_directory() {
    assert(match cwd() { Result.Ok(path) => len(path) > 0, _ => false });
}
