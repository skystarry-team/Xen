module std.convert;

enum ParseIntError {
    Empty,
    InvalidDigit((Int, U8)),
    Overflow,
}

fn parse_int(text: String) -> Result<Int, ParseIntError> {
    let bytes = text.as_bytes();
    let length = bytes.len();
    if length == 0 {
        return Result<Int, ParseIntError>.Err(ParseIntError.Empty);
    }

    let mut index = 0;
    let mut negative = false;
    let first = bytes.get(0);
    if first == u8(45) {
        negative = true;
        index = 1;
    } else if first == u8(43) {
        index = 1;
    }
    if index == length {
        return Result<Int, ParseIntError>.Err(ParseIntError.Empty);
    }

    // Accumulate in the negative range so Int.min never needs to be negated.
    let limit = if negative { -9223372036854775808 } else { -9223372036854775807 };
    let multiply_limit = limit / 10;
    let mut value: Int = 0;
    while index < length {
        let byte = bytes.get(index);
        if byte < u8(48) || byte > u8(57) {
            return Result<Int, ParseIntError>.Err(
                ParseIntError.InvalidDigit((index, byte))
            );
        }
        let digit = i64(byte) - 48;
        if value < multiply_limit {
            return Result<Int, ParseIntError>.Err(ParseIntError.Overflow);
        }
        value = value * 10;
        if value < limit + digit {
            return Result<Int, ParseIntError>.Err(ParseIntError.Overflow);
        }
        value = value - digit;
        index = index + 1;
    }

    if negative {
        return Result<Int, ParseIntError>.Ok(value);
    }
    return Result<Int, ParseIntError>.Ok(-value);
}

fn format_int(value: Int) -> String {
    if value == 0 {
        return "0";
    }

    // Keep the working value non-positive for the same Int.min reason as parse_int.
    let mut remaining = if value > 0 { -value } else { value };
    let mut reversed: Vec<U8> = [];
    while remaining != 0 {
        let digit = -(remaining % 10);
        reversed.push(u8(digit + 48));
        remaining = remaining / 10;
    }
    if value < 0 {
        reversed.push(u8(45));
    }

    let mut bytes: Vec<U8> = [];
    let mut index = reversed.len();
    while index > 0 {
        index = index - 1;
        bytes.push(reversed.get(index));
    }
    return bytes.into_string();
}
