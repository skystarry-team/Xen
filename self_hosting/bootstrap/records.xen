fn builtin_type(c: Int) -> Bool {
    if spelling(c, 3, 7630409, 0, 0) { return true; } // Int
    if spelling(c, 5, 499850898502, 0, 0) { return true; } // Float
    if spelling(c, 2, 14409, 0, 0) { return true; } // I8
    if spelling(c, 2, 14421, 0, 0) { return true; } // U8
    if spelling(c, 3, 3551561, 0, 0) { return true; } // I16
    if spelling(c, 3, 3551573, 0, 0) { return true; } // U16
    if spelling(c, 3, 3289929, 0, 0) { return true; } // I32
    if spelling(c, 3, 3289941, 0, 0) { return true; } // U32
    if spelling(c, 3, 3421769, 0, 0) { return true; } // I64
    if spelling(c, 3, 3421781, 0, 0) { return true; } // U64
    if spelling(c, 3, 3289926, 0, 0) { return true; } // F32
    if spelling(c, 3, 3421766, 0, 0) { return true; } // F64
    if spelling(c, 4, 1819242306, 0, 0) { return true; } // Bool
    if spelling(c, 6, 113723913172051, 0, 0) { return true; } // String
    if spelling(c, 4, 1701603654, 0, 0) { return true; } // File
    if spelling(c, 3, 6514006, 0, 0) { return true; } // Vec
    if spelling(c, 5, 435459550291, 0, 0) { return true; } // Slice
    if spelling(c, 3, 7500880, 0, 0) { return true; } // Ptr
    if spelling(c, 4, 1953066581, 0, 0) { return true; } // Unit
    if spelling(c, 6, 121424789663823, 0, 0) { return true; } // Option
    if spelling(c, 6, 128009175786834, 0, 0) { return true; } // Result
    if spelling(c, 5, 435526984018, 0, 0) { return true; } // Range
    return false;
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Function signatures and lexical variable bindings.

fn function_at(c: Int, index: Int) -> Int { return get(c, 7) + index * 256; }

fn find_function(c: Int, name: Int, size: Int) -> Int {
    let mut i = 0;
    while i < get(c, 8) {
        let f = function_at(c, i);
        if same(name, size, load(f), load(f + 8)) { return i; }
        i = i + 1;
    }
    return -1;
}

fn declarations(c: Int) {
    collect_records(c);
    capability(c);
    while kind(c) != 0 {
        if is_word(c, 127970521019507) {
            next(c); expect(c, 256); skip_body(c);
        } else {
        need_word(c, 28262);
        let name = address(c);
        let size = length(c);
        if reserved(word(c)) || builtin_name(c) { fail(c, 303); }
        expect(c, 256);
        if find_function(c, name, size) >= 0 { fail(c, 304); }
        let count = get(c, 8);
        if count >= 256 { fail(c, 206); }
        let f = function_at(c, count);
        store(f, name); store(f + 8, size);
        set(c, 8, count + 1);
        expect(c, 40);
        let mut n = 0;
        if kind(c) != 41 {
            let mut more = true;
            while more {
                if n >= 6 { fail(c, 305); }
                let p = f + 48 + n * 24;
                if reserved(word(c)) { fail(c, 303); }
                store(p, address(c)); store(p + 8, length(c)); expect(c, 256); expect(c, 58);
                let t = parse_type(c);
                if t == 0 { fail(c, 302); }
                store(p + 16, t);
                n = n + 1;
                more = take(c, 44);
            }
        }
        store(f + 24, n);
        expect(c, 41);
        let mut result = 0;
        if take(c, 259) { result = parse_type(c); }
        store(f + 32, result);
        store(f + 16, get(c, 4));
        expect(c, 123);
        let mut depth = 1;
        while depth > 0 {
            if kind(c) == 0 { fail(c, 101); }
            if kind(c) == 123 { depth = depth + 1; }
            if kind(c) == 125 { depth = depth - 1; }
            next(c);
        }
        }
    }
}

// Variable records: name address, name length, slot, type, mutable, depth.
fn variable(c: Int, index: Int) -> Int { return get(c, 9) + index * 48; }

fn lookup_variable(c: Int, name: Int, size: Int) -> Int {
    let mut i = get(c, 10);
    while i > 0 {
        i = i - 1;
        let v = variable(c, i);
        if same(name, size, load(v), load(v + 8)) { return v; }
    }
    return 0;
}

fn find_variable(c: Int, name: Int, size: Int) -> Int {
    let v = lookup_variable(c, name, size);
    if v == 0 { fail(c, 306); }
    return v;
}

fn declare(c: Int, name: Int, size: Int, t: Int, mutable: Int) -> Int {
    let count = get(c, 10);
    let depth = get(c, 11);
    let mut i = count;
    while i > 0 {
        i = i - 1;
        let v = variable(c, i);
        if load(v + 40) == depth && same(name, size, load(v), load(v + 8)) { fail(c, 307); }
    }
    if count >= 512 { fail(c, 207); }
    let v = variable(c, count);
    let slot = reserve(c, t);
    store(v, name); store(v + 8, size); store(v + 16, slot); store(v + 24, t);
    store(v + 32, mutable); store(v + 40, depth);
    set(c, 10, count + 1);
    return slot;
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// The supported bb assembly templates and Linux syscall signatures.

// Four exact asm templates, with full constraint/type validation.
fn template(c: Int) -> Int {
    expect(c, 258);
    let t = get(c, 2) + (get(c, 4) - 1) * 32;
    let p = get(c, 0) + load(t + 8);
    let n = load(t + 16);
    if n == 14 {
        let a = packed(p, 8);
        let b = packed(p + 8, 6);
        if a == 3204418277672906605 && b == 102707238165280 { return 1; }
        if a == 7594320607365721965 && b == 115944556866653 { return 2; }
        if a == 7594320607365721965 && b == 119200158854237 { return 4; }
    }
    if n == 21 && packed(p, 8) == 7021710470846771053 && packed(p + 8, 8) == 2334400046547610744 && packed(p + 16, 5) == 401200149083 { return 3; }
    fail(c, 401);
    return 0;
}

fn register_name(c: Int, wanted: Int) {
    if kind(c) != 258 || word(c) != wanted { fail(c, 402); }
    next(c);
}

fn assembly(c: Int) -> Int {
    if get(c, 16) == 0 { fail(c, 403); }
    next(c);
    let mut result = 0;
    if take(c, 60) { result = parse_type(c); expect(c, 62); }
    expect(c, 40);
    let op = template(c);
    let mut wanted = 0;
    if op == 1 || op == 3 { wanted = 1; }
    type_is(c, result, wanted);
    expect(c, 44); need_word(c, 28265); expect(c, 40); register_name(c, 6906994); expect(c, 44);
    type_is(c, expression(c, 1), 1); push(c); expect(c, 41); expect(c, 44);
    if wanted == 1 {
        need_word(c, 7632239); expect(c, 40); register_name(c, 7889266); expect(c, 41);
    } else {
        need_word(c, 28265); expect(c, 40); register_name(c, 6910834); expect(c, 44);
        type_is(c, expression(c, 1), 1); push(c); expect(c, 41);
    }
    expect(c, 41);
    if wanted == 0 { pop(c, 6); }
    pop(c, 7);
    if op == 1 { emit(c, 72); emit(c, 139); emit(c, 7); }
    if op == 2 { emit(c, 72); emit(c, 137); emit(c, 55); }
    if op == 3 { emit(c, 72); emit(c, 15); emit(c, 182); emit(c, 7); }
    if op == 4 { emit(c, 64); emit(c, 136); emit(c, 55); }
    if wanted == 0 { immediate(c, 0); }
    return wanted;
}

fn syscall_arity(w: Int) -> Int {
    if w == 3489282976841431411 { return 1; }
    if w == 3561340570879359347 { return 2; }
    if w == 3633398164917287283 { return 3; }
    if w == 3705455758955215219 { return 4; }
    if w == 3777513352993143155 { return 5; }
    if w == 3849570947031071091 { return 6; }
    if w == 3921628541068999027 { return 7; }
    return 0;
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Expression parsing, calls, constructors, postfix fields and precedence.

fn invocation(c: Int, name: Int, size: Int, w: Int) -> Int {
    let arity = syscall_arity(w);
    let output = w == 31081494762582640;
    let assertion = w == 128034677158753;
    let mut f = 0;
    let mut target = -1;
    let mut n = arity;
    let mut result = 1;
    if arity > 0 {
        if get(c, 16) == 0 { fail(c, 403); }
    } else if output || assertion { n = 1; result = 0; }
    else {
        if lookup_variable(c, name, size) != 0 { fail(c, 313); }
        target = find_function(c, name, size);
        if target < 0 { fail(c, 308); }
        f = function_at(c, target); n = load(f + 24); result = load(f + 32);
    }
    expect(c, 40);
    let mut i = 0;
    while i < n {
        if i > 0 { expect(c, 44); }
        let mut t = 1;
        if assertion { t = 2; }
        if target >= 0 { t = load(f + 48 + i * 24 + 16); }
        type_is(c, expression(c, 1), t);
        push(c);
        i = i + 1;
    }
    expect(c, 41);
    while i > 0 {
        i = i - 1;
        let mut reg = argument_register(i);
        if arity > 0 {
            if i == 0 { reg = 0; }
            else if i == 4 { reg = 10; }
            else { reg = argument_register(i - 1); }
        }
        if assertion { reg = 0; }
        pop(c, reg);
    }
    if arity > 0 { emit(c, 15); emit(c, 5); }
    else if output {
        emit(c, 232);
        let offset = get(c, 6);
        bytes(c, get(c, 17) - offset - 4, 4);
    } else if assertion {
        test(c);
        let ok = jump(c, 133);
        runtime_exit(c, 101);
        land(c, ok); immediate(c, 0);
    } else {
        let mut result_slot = 0;
        if result >= 3 {
            result_slot = reserve(c, result);
            emit(c, 76); emit(c, 141); emit(c, 149); bytes(c, -8 * (result_slot + 1), 4);
        }
        call(c, target);
        if result >= 3 { local_address(c, result_slot); }
    }
    return result;
}

// Collect initializer token ranges, then compile in declaration order, matching
// the original Xen checker even when literal fields are written out of order.
fn skip_initializer(c: Int) {
    let mut parentheses = 0;
    let mut braces = 0;
    let mut scanning = true;
    while scanning {
        let k = kind(c);
        if k == 0 { fail(c, 101); }
        if parentheses == 0 && braces == 0 && (k == 44 || k == 125) { scanning = false; }
        else {
            if k == 40 { parentheses = parentheses + 1; }
            if k == 41 { parentheses = parentheses - 1; }
            if k == 123 { braces = braces + 1; }
            if k == 125 { braces = braces - 1; }
            if parentheses < 0 || braces < 0 { fail(c, 101); }
            next(c);
        }
    }
}

fn constructor(c: Int, t: Int) -> Int {
    let initializers = allocate(4096);
    expect(c, 123);
    while kind(c) != 125 {
        let index = find_field(c, t, address(c), length(c));
        let entry = initializers + index * 16;
        if load(entry) != 0 { fail(c, 504); }
        expect(c, 256); expect(c, 58);
        store(entry, get(c, 4)); skip_initializer(c); store(entry + 8, get(c, 4));
        if kind(c) != 125 { expect(c, 44); }
    }
    expect(c, 125);
    let end = get(c, 4);
    let slot = reserve(c, t);
    let mut i = 0;
    while i < load(record_at(c, t) + 16) {
        let entry = initializers + i * 16;
        if load(entry) == 0 { fail(c, 504); }
        let f = field_at(c, t, i);
        set(c, 4, load(entry));
        let ft = expression(c, 1);
        type_is(c, ft, load(f + 16));
        if get(c, 4) != load(entry + 8) { fail(c, 101); }
        save_value(c, slot, load(f + 24), ft);
        i = i + 1;
    }
    set(c, 4, end); syscall2(11, initializers, 4096);
    local_address(c, slot); return t;
}

fn atom(c: Int) -> Int {
    if kind(c) == 257 {
        let value = load(token(c) + 24);
        if value == -9223372036854775808 { fail(c, 202); }
        immediate(c, -value); next(c); return 1;
    }
    if take(c, 40) { let t = expression(c, 1); expect(c, 41); return t; }
    if is_word(c, 7172961) { return assembly(c); }
    if kind(c) != 256 { fail(c, 103); }
    let w = word(c);
    if w == 1702195828 || w == 435728179558 {
        let mut value = 0;
        if w == 1702195828 { value = 1; }
        immediate(c, value); next(c); return 2;
    }
    let name = address(c);
    let size = length(c);
    next(c);
    if kind(c) == 40 { return invocation(c, name, size, w); }
    let r = find_record(c, name, size);
    if r >= 0 && kind(c) == 123 { return constructor(c, r + 3); }
    let v = find_variable(c, name, size);
    read_value(c, load(v + 16), load(v + 24));
    return load(v + 24);
}

fn primary(c: Int) -> Int {
    let mut t = atom(c);
    while take(c, 46) {
        let index = find_field(c, t, address(c), length(c));
        let f = field_at(c, t, index);
        expect(c, 256);
        t = load(f + 16);
        read_field(c, load(f + 24), t);
    }
    return t;
}

fn unary(c: Int) -> Int {
    let op = kind(c);
    if op == 45 || op == 43 || op == 33 || op == 126 {
        next(c);
        // Decimal tokens accumulate negatively, including Int.min.
        if op == 45 && kind(c) == 257 {
            immediate(c, load(token(c) + 24)); next(c); return 1;
        }
        let t = unary(c);
        if op == 33 {
            type_is(c, t, 2); test(c); emit(c, 15); emit(c, 148); emit(c, 192);
            emit(c, 72); emit(c, 15); emit(c, 182); emit(c, 192); return 2;
        }
        type_is(c, t, 1);
        if op == 45 { emit(c, 72); emit(c, 247); emit(c, 216); }
        if op == 126 { emit(c, 72); emit(c, 247); emit(c, 208); }
        return 1;
    }
    return primary(c);
}

fn precedence(op: Int) -> Int {
    if op == 265 { return 1; }
    if op == 264 { return 2; }
    if op == 260 || op == 261 { return 3; }
    if op == 60 || op == 62 || op == 262 || op == 263 { return 4; }
    if op == 124 { return 5; }
    if op == 94 { return 6; }
    if op == 38 { return 7; }
    if op == 266 || op == 267 { return 8; }
    if op == 43 || op == 45 { return 9; }
    if op == 42 || op == 47 || op == 37 { return 10; }
    return 0;
}

fn expression(c: Int, minimum: Int) -> Int {
    let mut t = unary(c);
    let mut p = precedence(kind(c));
    while p >= minimum {
        let op = kind(c);
        next(c);
        if op == 264 || op == 265 {
            type_is(c, t, 2); test(c);
            let mut condition = 132;
            if op == 265 { condition = 133; }
            let end = jump(c, condition);
            type_is(c, expression(c, p + 1), 2);
            land(c, end); t = 2;
        } else {
            push(c);
            let right = expression(c, p + 1);
            t = binary(c, op, t, right);
        }
        p = precedence(kind(c));
    }
    return t;
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Blocks, mutable places, control flow, function entry and return lowering.

fn block(c: Int) -> Bool {
    expect(c, 123);
    let depth = get(c, 11) + 1;
    set(c, 11, depth);
    let mut returns = false;
    while kind(c) != 125 {
        if kind(c) == 0 { fail(c, 101); }
        if returns { fail(c, 314); }
        let returned = statement(c);
        returns = returns || returned;
    }
    expect(c, 125);
    let mut count = get(c, 10);
    while count > 0 && load(variable(c, count - 1) + 40) == depth { count = count - 1; }
    set(c, 10, count); set(c, 11, depth - 1);
    return returns;
}

fn assignment_ahead(c: Int) -> Bool {
    if kind(c) != 256 { return false; }
    let tokens = get(c, 2);
    let mut i = get(c, 4) + 1;
    while i + 1 < get(c, 3) && load(tokens + i * 32) == 46 && load(tokens + (i + 1) * 32) == 256 {
        i = i + 2;
    }
    return i < get(c, 3) && load(tokens + i * 32) == 61;
}

fn statement(c: Int) -> Bool {
    if is_word(c, 7628140) {
        next(c);
        let mut mutable = 0;
        if is_word(c, 7632237) { mutable = 1; next(c); }
        let name = address(c);
        let size = length(c);
        if reserved(word(c)) { fail(c, 303); }
        expect(c, 256);
        let mut annotation = -1;
        if take(c, 58) { annotation = parse_type(c); }
        expect(c, 61);
        let t = expression(c, 1);
        if t == 0 { fail(c, 301); }
        if annotation >= 0 { type_is(c, t, annotation); }
        expect(c, 59);
        save_value(c, declare(c, name, size, t, mutable), 0, t);
        return false;
    }
    if is_word(c, 121437875889522) {
        next(c);
        let mut t = 0;
        if kind(c) != 59 { t = expression(c, 1); }
        else { immediate(c, 0); }
        type_is(c, t, get(c, 13)); expect(c, 59);
        if t >= 3 {
            emit(c, 72); emit(c, 139); emit(c, 149); bytes(c, -8 * (get(c, 21) + 1), 4);
            copy_memory(c, type_size(c, t), 2, 0);
        }
        epilogue(c); return true;
    }
    if is_word(c, 26217) {
        next(c); type_is(c, expression(c, 1), 2); test(c);
        let no = jump(c, 132);
        let yes_returns = block(c);
        let end = jump(c, 0);
        land(c, no);
        let mut no_returns = false;
        if is_word(c, 1702063205) {
            next(c);
            if is_word(c, 26217) { no_returns = statement(c); }
            else { no_returns = block(c); }
        }
        land(c, end);
        return yes_returns && no_returns;
    }
    if is_word(c, 435610544247) {
        next(c);
        let start = get(c, 6);
        type_is(c, expression(c, 1), 2); test(c);
        let end = jump(c, 132);
        block(c);
        let back = jump(c, 0);
        patch(c, back, start - back - 4, 4); land(c, end); return false;
    }
    if kind(c) == 123 { return block(c); }
    if assignment_ahead(c) {
        let v = find_variable(c, address(c), length(c));
        if load(v + 32) == 0 { fail(c, 309); }
        let mut t = load(v + 24);
        let mut offset = 0;
        next(c);
        while take(c, 46) {
            let index = find_field(c, t, address(c), length(c));
            let f = field_at(c, t, index);
            expect(c, 256); offset = offset + load(f + 24); t = load(f + 16);
        }
        expect(c, 61);
        type_is(c, expression(c, 1), t); expect(c, 59);
        save_value(c, load(v + 16), offset, t); return false;
    }
    expression(c, 1); expect(c, 59); return false;
}

fn compile_function(c: Int, index: Int) {
    let f = function_at(c, index);
    store(f + 40, get(c, 6));
    set(c, 4, load(f + 16)); set(c, 10, 0); set(c, 11, 0); set(c, 12, 0);
    set(c, 13, load(f + 32));
    emit(c, 85); emit(c, 72); emit(c, 137); emit(c, 229);
    emit(c, 72); emit(c, 129); emit(c, 236);
    let frame = get(c, 6); bytes(c, 0, 4);
    if load(f + 32) >= 3 {
        let destination = reserve(c, 1);
        set(c, 21, destination);
        emit(c, 76); emit(c, 137); emit(c, 208); save_local(c, destination);
    }
    // Save all raw argument registers before aggregate copies use rcx.
    let staging = get(c, 12);
    let mut i = 0;
    while i < load(f + 24) {
        let slot = reserve(c, 1);
        let reg = argument_register(i);
        let mut prefix = 72;
        if reg >= 8 { prefix = 76; }
        emit(c, prefix); emit(c, 137); emit(c, 192 + (reg % 8) * 8);
        save_local(c, slot); i = i + 1;
    }
    i = 0;
    while i < load(f + 24) {
        let p = f + 48 + i * 24;
        let t = load(p + 16);
        let slot = declare(c, load(p), load(p + 8), t, 0);
        read_local(c, staging + i); save_value(c, slot, 0, t);
        i = i + 1;
    }
    // Parameters share the outer body scope; duplicate let bindings are errors.
    set(c, 11, -1);
    let returns = block(c);
    if load(f + 32) != 0 && !returns { fail(c, 310); }
    immediate(c, 0); epilogue(c);
    let slots = get(c, 12);
    patch(c, frame, ((slots * 8 + 15) / 16) * 16, 4);
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Standalone ELF64 construction and the signed-decimal println runtime.

// A small signed-decimal println(Int) runtime. rdi is the input, all scratch
// registers are caller-saved; unsigned division handles abs(Int.min).
fn print_runtime(c: Int) {
    set(c, 17, get(c, 6));
    bytes(c, 3850979413, 4); // push rbp; mov rbp,rsp
    bytes(c, 1089241928, 4); // sub rsp,64
    bytes(c, 15108424, 3); // mov rsi,rsp
    bytes(c, 1069974344, 4); // add rsi,63
    bytes(c, 657094, 3); // mov byte [rsi],10
    emit(c, 185); bytes(c, 1, 4); // mov ecx,1
    bytes(c, 16288072, 3); // mov rax,rdi
    bytes(c, 12618057, 3); // mov r8,rax
    bytes(c, 1073267017, 4); // sar r8,63
    test(c); let positive = jump(c, 137);
    bytes(c, 14219080, 3); // neg rax
    land(c, positive);
    emit(c, 65); emit(c, 185); bytes(c, 10, 4); // mov r9d,10
    let loop = get(c, 6);
    bytes(c, 53809, 2); // xor edx,edx
    bytes(c, 15857481, 3); // div r9
    bytes(c, 3195520, 3); // add dl,48
    bytes(c, 13565768, 3); // dec rsi
    bytes(c, 5768, 2); // mov [rsi],dl
    bytes(c, 12713800, 3); // inc rcx
    test(c); let back = jump(c, 133); patch(c, back, loop - back - 4, 4);
    bytes(c, 12617037, 3); // test r8,r8
    let nonnegative = jump(c, 132);
    bytes(c, 13565768, 3); bytes(c, 2950854, 3); // dec rsi; mov byte [rsi],45
    bytes(c, 12713800, 3); land(c, nonnegative);
    bytes(c, 13273416, 3); // mov rdx,rcx
    let write = get(c, 6);
    emit(c, 191); bytes(c, 1, 4); emit(c, 184); bytes(c, 1, 4);
    emit(c, 15); emit(c, 5);
    // Retry EINTR; otherwise require progress and finish partial writes.
    emit(c, 72); emit(c, 131); emit(c, 248); emit(c, 252);
    let retry = jump(c, 132); patch(c, retry, write - retry - 4, 4);
    test(c); let progress = jump(c, 143);
    runtime_exit(c, 74);
    land(c, progress);
    emit(c, 72); emit(c, 41); emit(c, 194); // sub rdx,rax
    emit(c, 72); emit(c, 1); emit(c, 198); // add rsi,rax
    emit(c, 72); emit(c, 133); emit(c, 210); // test rdx,rdx
    let more = jump(c, 133); patch(c, more, write - more - 4, 4);
    epilogue(c);
}

fn elf(c: Int) {
    // ELF64 header + one executable PT_LOAD. No linker, libc, or interpreter.
    bytes(c, 1179403647, 4); emit(c, 2); emit(c, 1); emit(c, 1);
    bytes(c, 0, 9); bytes(c, 2, 2); bytes(c, 62, 2); bytes(c, 1, 4);
    bytes(c, 4194424, 8); bytes(c, 64, 8); bytes(c, 0, 8); bytes(c, 0, 4);
    bytes(c, 64, 2); bytes(c, 56, 2); bytes(c, 1, 2); bytes(c, 0, 6);
    bytes(c, 1, 4); bytes(c, 5, 4); bytes(c, 0, 8);
    bytes(c, 4194304, 8); bytes(c, 4194304, 8);
    bytes(c, 0, 8); bytes(c, 0, 8); bytes(c, 4096, 8);
}

