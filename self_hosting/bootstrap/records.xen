    if spelling(c, 9, 8245937481610387826, 101, 0) { return true; } // raw_store
    if spelling(c, 8, 7306371754492387698, 0, 0) { return true; } // raw_free
    if spelling(c, 8, 8242823587370792048, 0, 0) { return true; } // ptr_addr
    if spelling(c, 13, 7885647256562594928, 491310571871, 0) { return true; } // ptr_from_addr
    if spelling(c, 13, 7308332243887091574, 431131421791, 0) { return true; } // volatile_load
