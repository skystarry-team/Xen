// SPDX-License-Identifier: MIT OR Apache-2.0
// Frozen, self-contained scalar-syntax implementation of POD records.
// stdin: Xen source; stdout: Linux x86-64 ELF; stderr: E<code> <byte>.
#global[bb]

fn main() {
    let c = allocate(4096);
    set(c, 0, allocate(1048576)); set(c, 2, allocate(8388608));
    set(c, 5, allocate(4194304)); set(c, 7, allocate(65536));
    set(c, 9, allocate(24576)); set(c, 14, allocate(1048576));
    set(c, 18, allocate(262144));
    let mut size = 0;
    let mut done = false;
    while !done {
        if size == 1048576 { fail(c, 209); }
        let count = syscall3(0, 0, get(c, 0) + size, 1048576 - size);
        if count == 0 { done = true; }
        else if count != -4 {
            if count < 0 { fail(c, 210); }
            size = size + count;
        }
    }
    set(c, 1, size); lex(c); declarations(c);
    let mut entry = -1;
    let mut i = 0;
    while i < get(c, 8) {
        let f = function_at(c, i);
        if load(f + 8) == 4 && packed(load(f), 4) == 1852399981 { entry = i; }
        i = i + 1;
    }
    if entry < 0 { fail(c, 311); }
    let main_function = function_at(c, entry);
    if load(main_function + 24) != 0 || load(main_function + 32) != 0 { fail(c, 312); }
    elf(c); call(c, entry);
    immediate(c, 60); emit(c, 49); emit(c, 255); emit(c, 15); emit(c, 5);
    print_runtime(c);
    i = 0;
    while i < get(c, 8) { compile_function(c, i); i = i + 1; }
    i = 0;
    while i < get(c, 15) {
        let r = get(c, 14) + i * 16;
        let offset = load(r);
        let target = function_at(c, load(r + 8));
        patch(c, offset, load(target + 40) - offset - 4, 4);
        i = i + 1;
    }
    patch(c, 96, get(c, 6), 8); patch(c, 104, get(c, 6), 8);
    write_all(1, get(c, 5), get(c, 6));
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Linux memory and I/O. These are ordinary compiled Xen functions.

// The only memory primitives. These bodies are parsed and compiled normally.
fn load(address: Int) -> Int {
    return asm<Int>("mov rax, [rdi]", in("rdi", address), out("rax"));
}

fn store(address: Int, value: Int) {
    asm("mov [rdi], rsi", in("rdi", address), in("rsi", value));
}

fn byte(address: Int) -> Int {
    return asm<Int>("movzx rax, byte [rdi]", in("rdi", address), out("rax"));
}

fn put(address: Int, value: Int) {
    asm("mov [rdi], sil", in("rdi", address), in("rsi", value));
}

fn allocate(size: Int) -> Int {
    let address = syscall6(9, 0, size, 3, 34, -1, 0);
    if address < 0 { syscall1(60, 70); }
    return address;
}

fn write_all(fd: Int, address: Int, size: Int) {
    let mut done = 0;
    while done < size {
        let count = syscall3(1, fd, address + done, size - done);
        if count != -4 {
            if count <= 0 { syscall1(60, 74); }
            done = done + count;
        }
    }
}

fn character(fd: Int, value: Int) {
    let buffer = allocate(4096);
    put(buffer, value);
    write_all(fd, buffer, 1);
    syscall2(11, buffer, 4096);
}

fn number(fd: Int, value: Int) {
    let buffer = allocate(4096);
    let mut end = 64;
    let mut remaining = value;
    if remaining == 0 { end = end - 1; put(buffer + end, 48); }
    while remaining > 0 {
        end = end - 1;
        put(buffer + end, 48 + remaining % 10);
        remaining = remaining / 10;
    }
    write_all(fd, buffer + end, 64 - end);
    syscall2(11, buffer, 4096);
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// This scalar seed keeps compiler buffers and counters in raw memory.

// Context fields (8 bytes each): source, source size, tokens, token count,
// cursor, output, output size, functions, function count, variables, var count,
// lexical depth, frame slots, return type, call relocations, relocation count,
// bb capability, println runtime offset.
// The scalar seed passes the raw context address as Int.
fn get(c: Int, field: Int) -> Int { return load(c + field * 8); }

fn set(c: Int, field: Int, value: Int) { store(c + field * 8, value); }

// SPDX-License-Identifier: MIT OR Apache-2.0
// Token records, exact spelling, token navigation, and lexing.

fn token(c: Int) -> Int { return get(c, 2) + get(c, 4) * 32; }

fn kind(c: Int) -> Int { return load(token(c)); }

fn position(c: Int) -> Int { return load(token(c) + 8); }

fn length(c: Int) -> Int { return load(token(c) + 16); }

fn address(c: Int) -> Int { return get(c, 0) + position(c); }

fn next(c: Int) { set(c, 4, get(c, 4) + 1); }

fn expect(c: Int, wanted: Int) {
    if kind(c) != wanted { fail(c, 101); }
    next(c);
}

fn take(c: Int, wanted: Int) -> Bool {
    if kind(c) == wanted { next(c); return true; }
    return false;
}

fn packed(p: Int, size: Int) -> Int {
    let mut value = 0;
    let mut index = size;
    while index > 0 { index = index - 1; value = value * 256 + byte(p + index); }
    return value;
}

fn word(c: Int) -> Int {
    if length(c) > 8 { return 0; }
    return packed(address(c), length(c));
}

fn is_word(c: Int, value: Int) -> Bool { return kind(c) == 256 && word(c) == value; }

fn need_word(c: Int, value: Int) {
    if !is_word(c, value) { fail(c, 102); }
    next(c);
}

fn same(a: Int, n: Int, b: Int, m: Int) -> Bool {
    if n != m { return false; }
    let mut i = 0;
    while i < n { if byte(a + i) != byte(b + i) { return false; } i = i + 1; }
    return true;
}

fn letter(ch: Int) -> Bool {
    return ch >= 97 && ch <= 122 || ch >= 65 && ch <= 90 || ch == 95;
}

fn digit(ch: Int) -> Bool { return ch >= 48 && ch <= 57; }

fn add_token(c: Int, tag: Int, start: Int, size: Int, value: Int) {
    let count = get(c, 3);
    if count >= 262143 { fail(c, 201); }
    let t = get(c, 2) + count * 32;
    store(t, tag); store(t + 8, start); store(t + 16, size); store(t + 24, value);
    set(c, 3, count + 1);
}

fn lex(c: Int) {
    let source = get(c, 0);
    let size = get(c, 1);
    let mut i = 0;
    while i < size {
        let ch = byte(source + i);
        // The next free record is a diagnostic sentinel during lexing.
        set(c, 4, get(c, 3));
        store(token(c) + 8, i);
        if ch == 32 || ch == 9 || ch == 10 || ch == 13 { i = i + 1; }
        else if ch == 47 && i + 1 < size && byte(source + i + 1) == 47 {
            while i < size && byte(source + i) != 10 { i = i + 1; }
        } else if letter(ch) {
            let start = i;
            i = i + 1;
            while i < size && (letter(byte(source + i)) || digit(byte(source + i))) { i = i + 1; }
            add_token(c, 256, start, i - start, 0);
        } else if digit(ch) {
            let start = i;
            let mut value = 0;
            while i < size && digit(byte(source + i)) {
                let d = byte(source + i) - 48;
                if value < -922337203685477580 || value == -922337203685477580 && d > 8 { fail(c, 202); }
                value = value * 10 - d;
                i = i + 1;
            }
            add_token(c, 257, start, i - start, value);
        } else if ch == 34 {
            i = i + 1;
            let start = i;
            while i < size && byte(source + i) != 34 {
                // Only literal asm templates/registers are in this subset.
                if byte(source + i) == 92 || byte(source + i) < 32 { fail(c, 203); }
                i = i + 1;
            }
            if i == size { fail(c, 203); }
            add_token(c, 258, start, i - start, 0);
            i = i + 1;
        } else {
            let mut tag = ch;
            let mut width = 1;
            let mut following = 0;
            if i + 1 < size { following = byte(source + i + 1); }
            if ch == 45 && following == 62 { tag = 259; width = 2; }
            else if ch == 61 && following == 61 { tag = 260; width = 2; }
            else if ch == 33 && following == 61 { tag = 261; width = 2; }
            else if ch == 60 && following == 61 { tag = 262; width = 2; }
            else if ch == 62 && following == 61 { tag = 263; width = 2; }
            else if ch == 38 && following == 38 { tag = 264; width = 2; }
            else if ch == 124 && following == 124 { tag = 265; width = 2; }
            else if ch == 60 && following == 60 { tag = 266; width = 2; }
            else if ch == 62 && following == 62 { tag = 267; width = 2; }
            else if !(ch == 40 || ch == 41 || ch == 123 || ch == 125 || ch == 58 || ch == 44 || ch == 59 || ch == 61 || ch == 43 || ch == 45 || ch == 42 || ch == 47 || ch == 37 || ch == 33 || ch == 60 || ch == 62 || ch == 38 || ch == 124 || ch == 94 || ch == 126 || ch == 35 || ch == 91 || ch == 93 || ch == 46) { fail(c, 204); }
            add_token(c, tag, i, width, 0);
            i = i + width;
        }
    }
    add_token(c, 0, size, 0, 0);
    set(c, 4, 0);
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Compile errors. No executable bytes are published until compilation succeeds.

fn fail(c: Int, code: Int) {
    character(2, 69);
    number(2, code);
    character(2, 32);
    number(2, position(c));
    character(2, 10);
    syscall1(60, 1);
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// x86-64 byte encoding, frame storage, value copies, branches and integer lowering.

// Byte emitter, relative fixups, x86 register operations.
fn emit(c: Int, value: Int) {
    let size = get(c, 6);
    if size >= 4194304 { fail(c, 205); }
    put(get(c, 5) + size, value);
    set(c, 6, size + 1);
}

fn bytes(c: Int, value: Int, count: Int) {
    let mut v = value;
    let mut i = 0;
    while i < count { emit(c, v & 255); v = v >> 8; i = i + 1; }
}

fn patch(c: Int, offset: Int, value: Int, size: Int) {
    let mut v = value;
    let mut i = 0;
    while i < size { put(get(c, 5) + offset + i, v & 255); v = v >> 8; i = i + 1; }
}

fn immediate(c: Int, value: Int) { emit(c, 72); emit(c, 184); bytes(c, value, 8); }

fn push(c: Int) { emit(c, 80); }

fn pop(c: Int, reg: Int) {
    if reg >= 8 { emit(c, 65); emit(c, 88 + reg - 8); }
    else { emit(c, 88 + reg); }
}

fn argument_register(index: Int) -> Int {
    if index == 0 { return 7; }
    if index == 1 { return 6; }
    if index == 2 { return 2; }
    if index == 3 { return 1; }
    return index + 4;
}

fn save_local(c: Int, slot: Int) {
    emit(c, 72); emit(c, 137); emit(c, 133); bytes(c, -8 * (slot + 1), 4);
}

fn read_local(c: Int, slot: Int) {
    emit(c, 72); emit(c, 139); emit(c, 133); bytes(c, -8 * (slot + 1), 4);
}

fn local_address(c: Int, slot: Int) {
    emit(c, 72); emit(c, 141); emit(c, 133); bytes(c, -8 * (slot + 1), 4);
}

// Every frame region is independently reserved. A region's slot denotes its
// lowest address; packed Bool fields retain their one-byte Xen layout.
fn reserve(c: Int, t: Int) -> Int {
    let words = (type_size(c, t) + 7) / 8;
    let end = get(c, 12) + words;
    if end > 8192 { fail(c, 207); }
    set(c, 12, end);
    return end - 1;
}

// rax = source address; destination is [rbp+offset] or [rdx+offset].
// Only rcx is scratch; argument registers must be staged before copying.
fn copy_memory(c: Int, size: Int, base: Int, offset: Int) {
    let mut i = 0;
    while i + 8 <= size {
        emit(c, 72); emit(c, 139); emit(c, 136); bytes(c, i, 4);
        emit(c, 72); emit(c, 137); emit(c, 136 + base); bytes(c, offset + i, 4);
        i = i + 8;
    }
    while i < size {
        emit(c, 15); emit(c, 182); emit(c, 136); bytes(c, i, 4);
        emit(c, 136); emit(c, 136 + base); bytes(c, offset + i, 4);
        i = i + 1;
    }
}

fn save_value(c: Int, slot: Int, offset: Int, t: Int) {
    let displacement = -8 * (slot + 1) + offset;
    if t >= 3 { copy_memory(c, type_size(c, t), 5, displacement); }
    else {
        if t == 1 { emit(c, 72); emit(c, 137); }
        else { emit(c, 136); }
        emit(c, 133); bytes(c, displacement, 4);
    }
}

fn read_value(c: Int, slot: Int, t: Int) {
    if t >= 3 {
        local_address(c, slot);
        let snapshot = reserve(c, t);
        save_value(c, snapshot, 0, t); local_address(c, snapshot);
    } else if t == 2 {
        emit(c, 15); emit(c, 182); emit(c, 133); bytes(c, -8 * (slot + 1), 4);
    } else { read_local(c, slot); }
}

fn read_field(c: Int, offset: Int, t: Int) {
    if t >= 3 { emit(c, 72); emit(c, 141); }
    else if t == 1 { emit(c, 72); emit(c, 139); }
    else { emit(c, 15); emit(c, 182); }
    emit(c, 128); bytes(c, offset, 4);
}

fn jump(c: Int, condition: Int) -> Int {
    if condition == 0 { emit(c, 233); }
    else { emit(c, 15); emit(c, condition); }
    let offset = get(c, 6);
    bytes(c, 0, 4);
    return offset;
}

fn land(c: Int, offset: Int) { patch(c, offset, get(c, 6) - offset - 4, 4); }

fn test(c: Int) { emit(c, 72); emit(c, 133); emit(c, 192); }

fn epilogue(c: Int) { emit(c, 201); emit(c, 195); }

fn runtime_exit(c: Int, status: Int) {
    immediate(c, 60); emit(c, 191); bytes(c, status, 4); emit(c, 15); emit(c, 5);
}

fn call(c: Int, target: Int) {
    let n = get(c, 15);
    if n >= 65536 { fail(c, 208); }
    emit(c, 232);
    let offset = get(c, 6);
    bytes(c, 0, 4);
    store(get(c, 14) + n * 16, offset); store(get(c, 14) + n * 16 + 8, target);
    set(c, 15, n + 1);
}

fn binary(c: Int, op: Int, left: Int, right: Int) -> Int {
    type_is(c, right, left);
    if op == 260 || op == 261 {
        if left != 1 && left != 2 { fail(c, 301); }
    } else { type_is(c, left, 1); }
    // right in rax, left in rcx.
    pop(c, 1);
    if op == 43 { emit(c, 72); emit(c, 1); emit(c, 200); }
    else if op == 45 { emit(c, 72); emit(c, 41); emit(c, 193); emit(c, 72); emit(c, 137); emit(c, 200); }
    else if op == 42 { emit(c, 72); emit(c, 15); emit(c, 175); emit(c, 193); }
    else if op == 47 || op == 37 {
        test(c); let nonzero = jump(c, 133);
        runtime_exit(c, 101); land(c, nonzero);
        // Both division and remainder reject Int.min / -1 before idiv.
        emit(c, 72); emit(c, 131); emit(c, 248); emit(c, 255); // cmp rax,-1
        let ordinary_divisor = jump(c, 133);
        emit(c, 72); emit(c, 186); bytes(c, -9223372036854775808, 8); // mov rdx,Int.min
        emit(c, 72); emit(c, 57); emit(c, 209); // cmp rcx,rdx
        let ordinary_dividend = jump(c, 133);
        runtime_exit(c, 101);
        land(c, ordinary_divisor); land(c, ordinary_dividend);
        emit(c, 72); emit(c, 137); emit(c, 198); // mov rsi,rax
        emit(c, 72); emit(c, 137); emit(c, 200); // mov rax,rcx
        emit(c, 72); emit(c, 153); emit(c, 72); emit(c, 247); emit(c, 254);
        if op == 37 { emit(c, 72); emit(c, 137); emit(c, 208); }
    } else if op == 38 || op == 124 || op == 94 {
        let mut instruction = 33;
        if op == 124 { instruction = 9; }
        if op == 94 { instruction = 49; }
        emit(c, 72); emit(c, instruction); emit(c, 200);
    } else if op == 266 || op == 267 {
        // Unsigned comparison also rejects negative counts.
        emit(c, 72); emit(c, 131); emit(c, 248); emit(c, 63);
        let valid = jump(c, 134);
        runtime_exit(c, 101);
        land(c, valid);
        emit(c, 72); emit(c, 145); // xchg rax,rcx
        emit(c, 72); emit(c, 211);
        if op == 266 { emit(c, 224); } else { emit(c, 248); }
    } else {
        emit(c, 72); emit(c, 57); emit(c, 193); // cmp rcx,rax
        let mut cc = 148;
        if op == 261 { cc = 149; }
        if op == 60 { cc = 156; }
        if op == 62 { cc = 159; }
        if op == 262 { cc = 158; }
        if op == 263 { cc = 157; }
        emit(c, 15); emit(c, cc); emit(c, 192);
        emit(c, 72); emit(c, 15); emit(c, 182); emit(c, 192);
        return 2;
    }
    return 1;
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// POD record declarations, exact Xen layouts, fields and cycle checking.

fn type_is(c: Int, actual: Int, wanted: Int) { if actual != wanted { fail(c, 301); } }

fn parse_type(c: Int) -> Int {
    let w = word(c);
    let record = find_record(c, address(c), length(c));
    expect(c, 256);
    if w == 7630409 { return 1; } // Int
    if w == 1819242306 { return 2; } // Bool
    if w == 1953066581 { return 0; } // Unit
    if record >= 0 { return record + 3; }
    fail(c, 302);
    return 0;
}

// Record header: name, length, field count, byte size, alignment, DFS state,
// body token position. Fields (40 bytes): name, length, type, offset, source token.
fn record_at(c: Int, t: Int) -> Int { return get(c, 18) + (t - 3) * 2048; }

fn field_at(c: Int, t: Int, index: Int) -> Int { return record_at(c, t) + 64 + index * 40; }

fn find_record(c: Int, name: Int, size: Int) -> Int {
    let mut i = 0;
    while i < get(c, 19) {
        let r = record_at(c, i + 3);
        if same(name, size, load(r), load(r + 8)) { return i; }
        i = i + 1;
    }
    return -1;
}

fn find_field(c: Int, t: Int, name: Int, size: Int) -> Int {
    if t < 3 { fail(c, 503); }
    let mut i = 0;
    while i < load(record_at(c, t) + 16) {
        let f = field_at(c, t, i);
        if same(name, size, load(f), load(f + 8)) { return i; }
        i = i + 1;
    }
    fail(c, 503);
    return 0;
}

fn type_size(c: Int, t: Int) -> Int {
    if t == 0 { return 0; }
    if t == 1 { return 8; }
    if t == 2 { return 1; }
    resolve_record(c, t);
    return load(record_at(c, t) + 24);
}

fn type_alignment(c: Int, t: Int) -> Int {
    if t == 1 { return 8; }
    if t <= 2 { return 1; }
    resolve_record(c, t);
    return load(record_at(c, t) + 32);
}

fn align(value: Int, alignment: Int) -> Int { return ((value + alignment - 1) / alignment) * alignment; }

fn resolve_record(c: Int, t: Int) {
    let r = record_at(c, t);
    if load(r + 40) == 2 { return; }
    if load(r + 40) == 1 { fail(c, 505); }
    store(r + 40, 1);
    let mut size = 0;
    let mut alignment = 1;
    let mut i = 0;
    while i < load(r + 16) {
        let f = field_at(c, t, i);
        let ft = load(f + 16);
        let a = type_alignment(c, ft);
        let n = type_size(c, ft);
        if a > alignment { alignment = a; }
        size = align(size, a);
        store(f + 24, size);
        // Each child has already passed the same cap, preventing overflow.
        size = size + n;
        if size > 32768 { fail(c, 506); }
        i = i + 1;
    }
    store(r + 24, align(size, alignment)); store(r + 32, alignment); store(r + 40, 2);
}

fn skip_body(c: Int) {
    expect(c, 123);
    let mut depth = 1;
    while depth > 0 {
        if kind(c) == 0 { fail(c, 101); }
        if kind(c) == 123 { depth = depth + 1; }
        if kind(c) == 125 { depth = depth - 1; }
        next(c);
    }
}

fn capability(c: Int) {
    if take(c, 35) {
        need_word(c, 119165519096935); expect(c, 91); need_word(c, 25186); expect(c, 93);
        set(c, 16, 1);
    }
}

fn collect_records(c: Int) {
    capability(c);
    // Register every record name before reading field types or signatures.
    while kind(c) != 0 {
        if is_word(c, 127970521019507) {
            next(c);
            if reserved(word(c)) || builtin_type(c) { fail(c, 303); }
            if find_record(c, address(c), length(c)) >= 0 { fail(c, 501); }
            let n = get(c, 19);
            if n >= 128 { fail(c, 506); }
            let r = record_at(c, n + 3);
            store(r, address(c)); store(r + 8, length(c)); expect(c, 256);
            store(r + 48, get(c, 4)); set(c, 19, n + 1);
        } else {
            need_word(c, 28262);
            while kind(c) != 123 {
                if kind(c) == 0 { fail(c, 101); }
                next(c);
            }
        }
        skip_body(c);
    }
    let mut i = 0;
    while i < get(c, 19) {
        let r = record_at(c, i + 3);
        set(c, 4, load(r + 48)); expect(c, 123);
        let mut n = 0;
        while kind(c) != 125 {
            if n >= 32 { fail(c, 506); }
            let name = address(c);
            let size = length(c);
            if reserved(word(c)) { fail(c, 303); }
            let mut j = 0;
            while j < n {
                let previous = field_at(c, i + 3, j);
                if same(name, size, load(previous), load(previous + 8)) { fail(c, 502); }
                j = j + 1;
            }
            let f = field_at(c, i + 3, n);
            store(f, name); store(f + 8, size); store(f + 32, get(c, 4));
            expect(c, 256); expect(c, 58);
            let t = parse_type(c);
            if t == 0 { fail(c, 302); }
            store(f + 16, t); n = n + 1;
            if kind(c) != 125 { expect(c, 44); }
        }
        if n == 0 { fail(c, 502); }
        store(r + 16, n); expect(c, 125);
        i = i + 1;
    }
    i = 0;
    while i < get(c, 19) { resolve_record(c, i + 3); i = i + 1; }
    set(c, 4, 0);
}

// SPDX-License-Identifier: MIT OR Apache-2.0
// Xen keyword and reserved builtin spelling. Decimal constants pack ASCII bytes.

fn reserved(w: Int) -> Bool {
    return w == 28262 || w == 7628140 || w == 7632237 || w == 26217 || w == 1702063205 || w == 435610544247 || w == 121437875889522 || w == 1702195828 || w == 435728179558 || w == 7172961 || w == 7499622 || w == 28265 || w == 461195539042 || w == 7310870969309884259 || w == 448345170285;
}

// Match exact ASCII spelling without introducing String values into the subset.
fn spelling(c: Int, size: Int, head: Int, middle: Int, tail: Int) -> Bool {
    if length(c) != size { return false; }
    let p = address(c);
    let mut n = size;
    if n > 8 { n = 8; }
    if packed(p, n) != head { return false; }
    if size > 8 {
        n = size - 8;
        if n > 8 { n = 8; }
        if packed(p + 8, n) != middle { return false; }
    }
    if size > 16 && packed(p + 16, size - 16) != tail { return false; }
    return true;
}

// Keep this list in sync with compiler/common/checker.ml's function builtins.
fn builtin_name(c: Int) -> Bool {
    if spelling(c, 2, 14441, 0, 0) { return true; } // i8
    if spelling(c, 2, 14453, 0, 0) { return true; } // u8
    if spelling(c, 3, 3551593, 0, 0) { return true; } // i16
