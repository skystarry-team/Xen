// Entry point. See sources.list for the complete compilation unit.
// Native CLI; build - -o - compiles stdin to stdout.
#global[bb]

fn main() {
    let options = cli_options();
    let c = make_context();
    read_input(c, options);
    compile(c);
    if options.mode == 1 { return; }
    save_output(c, options.output);
}

